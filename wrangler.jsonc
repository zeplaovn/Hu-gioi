{
  // Worker chỉ phục vụ file trong dist/; không có Node, SQLite hoặc logic gameplay.
  // dist/_headers do Cloudflare Worker Static Assets áp CSP + connect-src Supabase.
  "$schema": "https://json.schemastore.org/wrangler.json",
  "name": "hugioi",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "build": {
    "command": "npm run build:min"
  }
}
