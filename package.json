{
  "name": "hu-gioi",
  "version": "0.2.0",
  "private": true,
  "description": "Hư Giới — game idle tu tiên: client, dữ liệu thiết kế, engine luật dùng chung và máy chủ",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tools/build-dist.cjs",
