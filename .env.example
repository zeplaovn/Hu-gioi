# Chỉ mẫu cấu hình (KHÔNG cam kết sẽ vận hành được nếu chưa có backend Node HTTPS).
# Publishable key công khai; không sử dụng SUPABASE_SERVICE_ROLE_KEY ở frontend.
SUPABASE_URL=https://rvrwfeblishqadkpzspb.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_ACTIVE_KEY
# Tùy chọn: hCaptcha sitekey công khai (secret chỉ nhập ở Supabase Auth). Bỏ trống = tắt CAPTCHA.
# `npm run build` / `build:min` đưa 3 biến này vào dist/ (URL, khóa, CSP, sitekey); không đặt = giữ mặc định trong mã nguồn.
# Dùng cùng tên với Hugioi-dashboard.
HCAPTCHA_SITEKEY=
HOST=127.0.0.1
PORT=8000
HU_DB_FILE=.hu-gioi/game.sqlite
# Tùy chọn, chỉ ở máy chủ, bật xóa tài khoản tự phục vụ. TUYỆT ĐỐI không đưa vào frontend/Git.
# SUPABASE_SERVICE_ROLE_KEY=
NODE_ENV=development
# Bắt buộc khi chạy compose: địa chỉ IP thực tế của reverse proxy nhìn từ container.
# Không đặt 0.0.0.0 hay địa chỉ của người chơi; proxy phải ghi đè X-Forwarded-For.
HU_AUTH_TRUSTED_PROXY_IPS=REPLACE_WITH_PROXY_SOURCE_IP
# HU_ALLOWED_ORIGINS=https://your-frontend.example
